# =====================================================================================================
# Iron & Wrath (Project Codex: 4192 AD) — public repository
# This folder also holds private Warpedia / Warhammer 40k material (scraped data, rules dumps, GW-derived
# datasets). So this file is a WHITELIST: everything is ignored unless it is listed below with "!".
# To publish something new, add a "!path" line on purpose.
# =====================================================================================================

# 1. ignore everything at the top level ...
/*

# 2. ... except the game
!/.gitignore
!/README.md
!/LICENSE
!/LICENSE-RULES.md
!/website/
!/gametheory/

# ---------------------------------------------------------------------------------------------------
# gametheory/: keep the game, drop Warhammer reference material and calculation outputs
# ---------------------------------------------------------------------------------------------------
# Warhammer / Age of Sigmar reference material (copied rules text, datasheets, codex dumps) — never public
gametheory/*_ABILITIES_COMPENDIUM.md
gametheory/*_UNITS_AND_WEAPONS.md
gametheory/AOS_*
gametheory/SPACE_MARINES_*
gametheory/WARHAMMER_*
gametheory/MASTER_40K_*
gametheory/MASTER_DETACHMENTS_AND_STRATAGEMS_COMPENDIUM.md
gametheory/MASTER_FACTIONS_AND_ABILITIES_COMPENDIUM.md
gametheory/MASTER_FACTION_LIBRARY.json
gametheory/MECHANICS_AUDIT_DATABASE.json
gametheory/FACTION_ABILITIES_AND_TAXONOMY_ENGINE.md
gametheory/PROJECT_CODEX_ALL_25_FACTIONS.md
gametheory/UNITS_CALCULATION_PART1.md
gametheory/UNITS_CALCULATION_PART2.md
gametheory/scripts/parse_all_factions_db.py
gametheory/scripts/parse_rules_db.py
gametheory/scripts/datasheet_balance_formula.py

# internal notes, prompts and business planning (remove a line to publish it)
gametheory/GEMINI_PLAN_REVIEW.md
gametheory/PROMPT_FOR_CLAUDE_FACTION_ABILITIES.md
gametheory/COMMUNITY_CREATOR_MONETIZATION.md

# calculations: regenerated by the scripts (unit_calculator.py fit, battle_sim.py, verify_all.py …)
gametheory/calc_output/*
!gametheory/calc_output/calibration.json
gametheory/batch_checkpoint.json
gametheory/run_vacation_pipeline.sh
gametheory/generated_factions/
*.log

# ---------------------------------------------------------------------------------------------------
# website/: keep the app, drop local/dev files
# ---------------------------------------------------------------------------------------------------
website/node_modules/
website/.wrangler/
website/.dev.vars
website/**/*.env
website/**/.env*

# ---------------------------------------------------------------------------------------------------
# everywhere
# ---------------------------------------------------------------------------------------------------
node_modules/
__pycache__/
*.pyc
.venv/
venv/
.DS_Store
.env
.env.*
*.key
*.pem

# private trademark blocklist (validator input)
gametheory/catalogue/ip_blocklist.private.json

# designer-only notes built around other games' kits and maths (kept private; FACTION_REGISTRY.md replaces them)
gametheory/MASTER_FACTIONS_25_ROSTER.md
gametheory/FACTION_25_DATABASE.json
gametheory/MODEL_AGNOSTIC_PROXY_STANDARD.md
gametheory/UNITS_CALCULATION_REFERENCE.md
gametheory/STRATEGY_BLUEPRINT.md

# your local index with links to private notes
gametheory/README_LOCAL.md
