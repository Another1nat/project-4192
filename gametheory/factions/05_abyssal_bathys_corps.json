{
 "name": "The Abyssal Bathys-Corps",
 "verb": "DRAG",
 "identity": "Deep-sea pressure-suit divers, harpoon crews and leviathans. Slow, tough, and they pull the enemy to them: winch harpoons drag targets 3″, and a public Tide schedule tells both players when the Corps will strike.",
 "number": "05",
 "template": "C_gunline_siege_arcane",
 "status": "draft",
 "learned_from": [
  "Gemini #1 Winch-Harpoon Drag (unique), #3 Rising Tide (telegraphed), #2 pressure-fog capped at 15″",
  "AoS sea-elf tides (loved because it is predictable)"
 ],
 "risk_profile": "Low/medium. Gamble = position: anchor a unit in place for stronger, longer drags.",
 "core_rule": {
  "name": "Winch-Harpoons & the Rising Tide",
  "text": "Weapons with [HARPOON] that hit a Class 1–4 unit drag it 3″ straight toward the shooter (stop 1″ away; not out of engagement). The Tide is public: Round 1 Low Tide — units more than 15″ from the shooter cannot be targeted (the Hidden cap); Round 2 Flood — +2″ MOV and ranged weapons gain [ASSAULT]; Round 3 High Tide — [STRIKE FIRST]; Round 4 Ebb — units may Fall Back and still Shoot or Charge."
 },
 "gamble": {
  "name": "Anchor-Lock",
  "text": "When a unit with [HARPOON] activates: it cannot Move for the rest of the round, but its [HARPOON] weapons get +1 PEN and drag 6″ instead of 3″.",
  "risk_cost": "position"
 },
