{
 "name": "The Skitter-Kin & Rad-Scavengers",
 "verb": "SCURRY",
 "identity": "Tunnelling rat-kin hordes with unstable rad-tech. Cheap, cowardly and slippery: once per round a unit scurries away after an enemy activation, and their weapon-teams roll the dice on overcharged guns that might explode.",
 "number": "19",
 "template": "D_swarm_monster_speed",
 "status": "draft",
 "learned_from": [
  "AoS 4 rat-folk armies: Too Quick to Hit-Hit, up to 3 gnawholes, warpstone sparks (research 2026-10) — gnawholes NOT used (user: no portals)",
  "Gemini #1 react-move (capped at 3″), #2 overcharge D6 table, #3 swarm refill (capped 100%, once per round), #4 hidden weapon teams"
 ],
 "risk_profile": "Dice gamble (Overcharge) on tech units; the rest is low-risk mobility.",
 "core_rule": {
  "name": "Scurry · Seething Swarm",
  "text": "Scurry: once per round, after an enemy unit finishes an activation, one unengaged Skitter-Kin unit may make a free 3″ move (not toward the enemy that just activated). Skitter-Kin units may Fall Back without being Rattled. Seething Swarm: once per round, at the End of Round, one Class 1 [FRAIL] unit returns D3 slain models (never above Starting Strength)."
 },
 "gamble": {
  "name": "More-More Rad-Power!",
  "text": "When a unit with an [OVERLOAD] weapon is selected to Shoot, you may Overcharge: roll a D6 — 1 KABOOM: the unit suffers D3 Fatal Wounds and does not Shoot · 2–5: +1 to Wound and +1 Damage · 6: also +1 PEN and +2 Attacks.",
  "risk_cost": "durability (dice)"
 },
