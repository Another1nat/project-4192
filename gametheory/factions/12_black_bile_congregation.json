{
 "name": "The Black-Bile Congregation",
 "verb": "CORRODE",
 "identity": "Bloated plague-knights, shambling pox-carriers and rot-engines. Slow and very hard to kill; an armour-rotting aura grows each round (3″ → 6″ → 9″), so the longer the battle goes, the worse it is to stand near them.",
 "number": "12",
 "template": "D_swarm_monster_speed",
 "status": "draft",
 "learned_from": [
  "40k plague legions Contagion Range 3″→9″ and infected objectives (research 2026-10)",
  "Gemini #1 Rust & Rot (no tokens), #2 resilience capped at UNYIELDING 5+ (army-wide cap), #4 Infected Ground"
 ],
 "risk_profile": "Low (aura). Gamble = permanent durability: rupture the blight-sacs and lose UNYIELDING for good.",
 "core_rule": {
  "name": "Aura of Rust & Rot · Bloated Resilience",
  "text": "Enemy units within Contagion Range of any Black-Bile unit have −1 ARM (not cumulative). Contagion Range: 3″ in Round 1, 6″ in Round 2, 9″ from Round 3. Black-Bile units (except [EXPENDABLE] ones) have UNYIELDING 5+."
 },
 "gamble": {
  "name": "Rupture the Blight-Sacs",
  "text": "When a unit activates: each enemy unit within 3″ suffers D3 Fatal Wounds on a 4+. That Black-Bile unit loses UNYIELDING for the rest of the battle.",
  "risk_cost": "durability (permanent)"
 },
