{
 "name": "The Diesel-Skull War-Horde",
 "verb": "RAMPAGE",
 "identity": "Scrap-mech brutes, speed-maniac bikers and huge, inaccurate mobs. Buckets of bad dice that explode on 6s, and one battle-defining round of Scrap-Fury when the whole horde surges forward.",
 "number": "24",
 "template": "D_swarm_monster_speed",
 "status": "draft",
 "learned_from": [
  "40k greenskins Rampage (loved timing decision) — renamed, capped (+1 Attack and +2″ Charge, no army WARD, no Move + Charge)",
  "Gemini #2 Dakka (crit 6s), #3 ramming (Class 3–5 only), #5 wreck-run (signature stratagem)",
  "Sim evidence: Move + Charge rules broke balance (Cinder 69%) → not used even for one round"
 ],
 "risk_profile": "Dice (Overcrank table) + one timing decision (Scrap-Fury).",
 "core_rule": {
  "name": "Dakka & Scrap-Fury",
  "text": "Dakka: Diesel-Skull ranged weapons have [ASSAULT]; unmodified Hit rolls of 6 with them are critical and score 1 extra hit ([ONSLAUGHT 1]). Scrap-Fury (once per battle): declare in the Command Phase — until the End of Round, Diesel-Skull units get +1 Attack in melee and +2″ to Charge rolls."
 },
 "gamble": {
  "name": "Overcrank the Engine",
  "text": "When a Class 2–5 vehicle or bike unit activates, roll a D6: 1 the engine seizes (D3 Fatal Wounds, no Move this activation) · 2–3 +2″ MOV · 4–5 +4″ MOV · 6 +4″ MOV and +1 Attack in melee.",
  "risk_cost": "durability (dice)"
 },
