{
 "name": "The Sanguine Aristocracy",
 "verb": "FEED",
 "identity": "Vampire nobles, their deathless levies and blood-knights. Few, deadly duelists that heal by killing: if they are kept from fighting, they wither; if they reach the line, they top up and keep going.",
 "number": "06",
 "template": "B_melee_predator",
 "status": "draft",
 "learned_from": [
  "AoS vampire (Deathless Thralls, lords that heal) — healing is shared design space, user OK",
  "Gemini #1 The Hunger, #2 Scent of Blood, #3 Duellists"
 ],
 "risk_profile": "Low (heal on kill). Gamble = objective/position: the Red Thirst forces a charge and drops CTRL to 0.",
 "core_rule": {
  "name": "The Hunger",
  "text": "At the end of a Fight action in which a Sanguine unit destroyed 1+ enemy models, it heals 2 MIGHT (3 if it destroyed the whole enemy unit). For a multi-model unit, healing goes to its most damaged model first, then returns 1 slain model per 2 points left (never above Starting Strength)."
 },
 "gamble": {
  "name": "The Red Thirst",
  "text": "When a unit activates: +1 Attack in melee and +2″ to Charge rolls this activation, but it must declare a Charge against the closest visible enemy unit if able, and its CTRL is 0 until it next activates.",
  "risk_cost": "objective / position"
 },
