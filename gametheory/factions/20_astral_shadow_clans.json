{
 "name": "The Astral Shadow-Clans",
 "verb": "AGONY",
 "identity": "Dark-tech raider clans and cyber-ronin swordsmen on blade-skiffs. Glass cannons that grow stronger as the battle bleeds: every enemy unit they destroy adds Agony they spend to empower their next strike.",
 "number": "20",
 "template": "A_combined_arms",
 "status": "draft",
 "learned_from": [
  "40k dark-raider elves pain tokens (loved: snowball through kills, tokens are yours, not on enemies) — renamed Agony Harvest",
  "Gemini #1 pain, #2 venom weapons, #3 skiff strikes (re-embark removed: too slippery), #5 single-leader veil (renamed, enhancement only)",
  "User: no portals — Gemini's portal strikes cut"
 ],
 "risk_profile": "Resource. Gamble = all-in: spend the whole Agony bank on one assassination.",
 "core_rule": {
  "name": "Agony Harvest",
  "text": "Start the battle with 2 Agony (max 4). Gain 1 each time an enemy unit is destroyed. When a unit activates, spend 1 Agony to Empower it until the end of the activation: re-roll Hit rolls, +1 PEN in melee and +2″ to Charge rolls. Agony is your own resource; it is never placed on enemy units."
 },
 "gamble": {
  "name": "All-In Assassination",
  "text": "Once per battle, spend ALL Agony (minimum 2) when a unit activates: its weapons gain [PRECISION] and [SHREDDING WOUNDS] this activation; you cannot gain Agony again until the End of Round.",
  "risk_cost": "resource"
 },
