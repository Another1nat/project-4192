{
 "name": "The Radiant Concordat",
 "verb": "SPOT",
 "identity": "Porcelain rail-gun infantry and battlesuits, blood-lotus priests, and hulking gore-ogre auxiliaries. Poor in melee, deadly when spotted targets line up, and the ogres stand in front of the porcelain.",
 "number": "22",
 "template": "C_gunline_siege_arcane",
 "status": "draft",
 "learned_from": [
  "A sci-fi wargame's railgun empire: observer/guided fire, and a patient vs killing-blow doctrine as a timing choice",
  "Gemini #1 Spotters + Blood-Offering, #2 Ogre Bulwark (rewritten as a once-per-round intercept), #3 pacing → detachments"
 ],
 "risk_profile": "Medium. Gamble = durability: the Blood-Offering bleeds your own ogres to make a spotted volley lethal.",
 "core_rule": {
  "name": "Crimson-Lotus Spotters · Gilded Bulwark",
  "text": "Spot: an unengaged Concordat unit may use 1 Action to Spot a visible enemy unit; the next friendly unit to Shoot that enemy this round gets +1 to Hit and [IGNORES COVER] (one Spot per enemy unit per round). Bulwark: once per round, when an enemy unit declares a Charge against a Concordat Class 1–2 unit within 3″ of Gore-Brutes or Gore-Ogres, those ogres may make a 3″ move to engage the charger before the Charge roll."
 },
 "gamble": {
  "name": "Blood-Offering",
  "text": "When a unit Spots within 6″ of a Blood-Lotus Prior, the Prior may inflict D3 Fatal Wounds on a friendly ogre unit within 3″: the spotted attack also gains [SHREDDING WOUNDS].",
  "risk_cost": "durability (friendly)"
 },
