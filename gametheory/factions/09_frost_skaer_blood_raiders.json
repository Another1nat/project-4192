{
 "name": "The Frost-Skaer Blood-Raiders",
 "verb": "SAGA",
 "identity": "Runic berserkers, shield-walls, frost-bear riders and war-mammoths. The army improves permanently by completing public Sagas mid-battle, so both players fight over whether the deed happens.",
 "number": "09",
 "template": "B_melee_predator",
 "status": "draft",
 "learned_from": [
  "40k wolf-warrior armies Sagas (2022) — loved when public and achievable",
  "Gemini #1 Sworn Sagas, #2 Blizzard, #3 Berserker Fury"
 ],
 "risk_profile": "Low (Sagas). Gamble = tempo: boast a deed for this round; fail and the boaster is Rattled.",
 "core_rule": {
  "name": "Sworn Sagas",
  "text": "Three public Sagas; each unlocks a permanent army-wide rune the moment it is completed: Saga of the Warrior-Born (destroy an enemy Leader) → melee [STRIKE FIRST] on a round your unit charged; Saga of the Beast-Slayer (destroy a Class 4–5 unit) → melee weapons gain [IMPALING HITS]; Saga of the Bear (a unit below Half-Strength survives a round) → UNYIELDING 6+."
 },
 "gamble": {
  "name": "Death-Saga Boast",
  "text": "Command Phase: one Leader boasts a deed for this round (destroy a named enemy unit, or control a named objective). Success: +1 CP and that Leader gets +1 Attack for the rest of the battle. Failure: the Leader and its attached unit are Rattled.",
  "risk_cost": "tempo"
 },
