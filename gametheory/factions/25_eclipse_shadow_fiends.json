{
 "name": "The Eclipse Shadow-Fiends",
 "verb": "HAUNT",
 "identity": "The only phantom army: void-spectres, reaper-knights and wailing hosts. Their bodies ignore armour penetration (a WARD instead of ARM: 5+ for troops, 4+ for elites and Leaders), they terrify what they charge, and each round one unit vanishes into the umbra and reappears elsewhere.",
 "number": "25",
 "template": "B_melee_predator",
 "status": "draft",
 "learned_from": [
  "AoS 4 ghost armies: 5+ ward on everything (research 2026-10) — kept at 5+ for troops; 4+ only on elite/Leader datasheets",
  "Gemini #1 Ethereal (no army-wide 4+), #2 Wave of Terror, #3 Umbra redeploy (1 unit per round)"
 ],
 "risk_profile": "Exposure. Gamble = Phase-Walk: move through anything, lose the ward until next activation.",
 "core_rule": {
  "name": "Ethereal Phase-Form · Wave of Terror",
  "text": "Ethereal: Eclipse units have no ARM save; instead they have the WARD shown on their datasheet (5+ troops, 4+ elites/Leaders, 5+ for Class 4–5), which no PEN can worsen, and they are [STEALTH] against attacks from more than 12″. Wave of Terror: when an Eclipse unit ends a Charge, pick 1 engaged enemy unit: it gets −1 to Hit in melee until the End of Round."
 },
 "gamble": {
  "name": "Phase-Walk",
  "text": "When a unit activates: it moves through models and terrain and gets +2″ to its Charge roll this activation, but it loses its WARD until it next activates.",
  "risk_cost": "exposure"
 },
