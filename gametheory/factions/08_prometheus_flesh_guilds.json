{
 "name": "The Prometheus Flesh-Guilds",
 "verb": "GRAFT",
 "identity": "Cyborg tech-surgeons and stitched brutes. They harvest scrap and organs from the dead around them and graft permanent upgrades onto their units mid-battle: a slow start that becomes a custom monster by Round 3.",
 "number": "08",
 "template": "A_combined_arms",
 "status": "draft",
 "learned_from": [
  "Gemini #1 Grafting (highest uniqueness), #3 surgeon heals, #4 voluntary Lightning-Coil",
  "REJECTED Gemini #5 Rad-Saturation (pre-movement damage = NPE, like 40k 2022 Rad-Cohort complaints)"
 ],
 "risk_profile": "Low (permanent grafts). Gamble = durability + resource: Over-Graft two at once, may burn out.",
 "core_rule": {
  "name": "Organ & Scrap Harvest",
  "text": "When any unit (friend or foe) is destroyed within 6″ of a Prometheus unit, gain 1 Graft (max 3 banked). When a unit activates, spend 1 Graft to give it ONE permanent upgrade for the rest of the battle: +1 PEN on one weapon · +1 to Hit with one weapon · heal D3 MIGHT and +1 MIGHT maximum (once). Each unit can take each upgrade once."
 },
 "gamble": {
  "name": "Over-Graft",
  "text": "Spend 2 Grafts on one unit at once for two different upgrades, then roll a D6: on a 1 the unit suffers D3 Fatal Wounds and loses one of the new upgrades (your choice).",
  "risk_cost": "durability + resource"
 },
