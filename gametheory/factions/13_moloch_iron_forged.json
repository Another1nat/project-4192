  "AoS daemon-smith dwarves (Smog and Smoke: −1 to Hit infantry near war machines) — research 2026-10",
  "Gemini #1 Feed the Furnace (sacrifice belongs here, not on an elite army), #2 Siege-Masters, #3 anvil repair"
 ],
 "risk_profile": "Medium. Gamble = durability (dice): red-line the boilers for more attacks, natural 1s hurt the engine.",
 "core_rule": {
  "name": "Feed the Furnace · Siege-Masters",
  "text": "Feed the Furnace: when a Class 4–5 Moloch unit activates, you may remove 1 model from a friendly [EXPENDABLE] Class 1 unit within 3″: this activation its weapons gain [RELENTLESS] (re-roll Wound rolls) and [ONSLAUGHT 1]. Siege-Masters: Moloch ranged weapons gain [IGNORES COVER] against units within 3″ of an objective or in Dense terrain."
 },
 "gamble": {
  "name": "Red-Line the Boilers",
  "text": "When a Class 3–5 unit is selected to Shoot or Fight: its weapons get +2 Attacks; afterwards it suffers 1 Fatal Wound for each natural 1 rolled to Hit (max D3+1).",
  "risk_cost": "durability (dice)"
 },
