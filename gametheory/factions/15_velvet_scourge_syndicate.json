{
 "name": "The Velvet-Scourge Syndicate",
 "verb": "TEMPT",
 "identity": "Pain-addicted duelists, sonic cultists and rapture-engines. Fast and fragile; hurting them makes them better, and once per round they offer the opponent a Temptation where the opponent chooses which punishment to take.",
 "number": "15",
 "template": "D_swarm_monster_speed",
 "status": "draft",
 "learned_from": [
  "A sci-fi wargame's excess legion: fall back or advance and still shoot and charge — research 2026-10",
  "Gemini #1 Ecstasy of Pain, #2 Temptation (opponent picks = low toxicity), #3 sonic weapons"
 ],
 "risk_profile": "Opponent's choice (Temptation). Low otherwise.",
 "core_rule": {
  "name": "Ecstasy of Pain",
  "text": "A Velvet-Scourge unit that is below Starting Strength (or damaged), or that destroyed an enemy model this round, gets +1 to Hit and +1″ MOV."
 },
 "gamble": {
  "name": "Temptation",
  "text": "Once per round, when a unit is selected to Shoot or Fight, offer the opponent a Temptation. The OPPONENT chooses: the target unit suffers D3 Fatal Wounds now, OR your unit's weapons gain [ONSLAUGHT 2] for this attack.",
  "risk_cost": "opponent's choice"
 },
