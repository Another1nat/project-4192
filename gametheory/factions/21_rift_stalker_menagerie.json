{
 "name": "The Rift-Stalker Menagerie",
 "verb": "CONTRACT",
 "identity": "The universal proxy faction: wasteland mercenaries, outcasts and tamed beasts. Any of the 29 universal archetypes is a legal Rift-Stalker datasheet; these 20 are the named core. Before the battle you sign 2 of 5 Mercenary Contracts.",
 "number": "21",
 "template": "A_combined_arms",
 "status": "draft",
 "learned_from": [
  "User: faction 21 = random proxy faction where everything is valid",
  "Gemini: all 5 contracts as a menu (CP contract capped to 2 rounds)"
 ],
 "risk_profile": "Low; the gamble is a pre-battle Objective Wager.",
 "core_rule": {
  "name": "Mercenary Contracts (pick 2 of 5)",
  "text": "Bounty Hunters: mark 2 enemy units; re-roll Hit and Wound rolls of 1 against them; +1 CP when one is destroyed · Guerrilla Infiltrators: 2 units gain [INFILTRATORS] and [SCOUTS 6″]; your units count as in Cover against attacks from more than 15″ · Shock & Awe: melee weapons gain [CRASHING], ranged weapons gain [ASSAULT] · Scavenged Grit: UNYIELDING 6+; Class 4–5 units heal 1 MIGHT at the End of Round · Master Tacticians: +1 CP in the Command Phase of Rounds 1 and 3. Any universal archetype (catalogue/unit_archetypes.json) is a legal datasheet at its catalogue price."
 },
 "gamble": {
  "name": "Objective Wager",
  "text": "Before deployment, secretly note one no-man's-land objective. Reveal at the end of Round 4: if you control it, +3 VP; if your opponent does, they score +2 VP.",
  "risk_cost": "objective"
 },
