{
 "name": "The Aegis Knight-Houses",
 "verb": "FACING",
 "identity": "Feudal houses of steam-and-ion war-walkers with squire retainers. Few, huge models whose shields only face forward: the opponent wins by flanking, the knight player wins by turning to meet them and by the joust.",
 "number": "04",
 "template": "C_gunline_siege_arcane",
 "status": "draft",
 "learned_from": [
  "40k knight-walker armies (big-model elite; Bondsman)",
  "Gemini #1 Directional Ion-Shields, #3 Thunderous Joust, #4 Squire Bondsman",
  "Front-arc only so counterplay is positioning, not dice"
 ],
 "risk_profile": "Medium. Gamble = durability dice: vent the reactor for stronger shields and attacks, risk D3 Fatal Wounds.",
 "core_rule": {
  "name": "Ion Bulwark & Thunderous Joust",
  "text": "Class 3–5 units have WARD 5+ against ranged attacks from models whose bases are in their front 180° arc (mark the front of the base). Class 3–5 units that charged trigger Crushing Impact for 0 CP and their melee weapons gain [CRASHING] that activation."
 },
 "gamble": {
  "name": "Vent the Reactor",
  "text": "When a Class 3–5 unit activates: its front-arc WARD becomes 4+ and its weapons get +1 Attack until the End of Round. At the End of Round roll a D6: on 1–2 it suffers D3 Fatal Wounds.",
  "risk_cost": "durability (dice)"
 },
