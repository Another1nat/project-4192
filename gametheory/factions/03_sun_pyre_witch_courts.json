{
 "name": "The Sun-Pyre Witch-Courts",
 "verb": "FAITH",
 "identity": "Zealot witch-hunters, warrior-sisters and self-scourging penitents. Fragile bodies, burning weapons, and a bank of Pyre-Dice that turns one roll per activation into a miracle.",
 "number": "03",
 "template": "A_combined_arms",
 "status": "draft",
 "learned_from": [
  "40k battle-sister armies Miracle Dice (loved; capped bank fixes the 2022 complaints)",
  "Gemini idea #1 & #2 (Pyre-Dice, Blood of Martyrs)"
 ],
 "risk_profile": "Low by default (dice bank). Gamble = resource: empty the whole bank for one huge activation.",
 "core_rule": {
  "name": "Pyre-Dice",
  "text": "Command Phase: roll 1 D6 and bank it as a Pyre-Die (keep the result). Also bank 1 when a friendly unit is destroyed. Maximum 3 banked. Once per activation, before rolling, you may replace ONE of your own Hit, Wound, ARM-save or Charge dice with a banked die. Pyre-Dice are never used on the opponent's rolls."
 },
 "gamble": {
  "name": "Martyr's Pyre",
  "text": "Once per battle, when a unit activates, spend ALL banked Pyre-Dice (minimum 2): its weapons gain [SHREDDING WOUNDS] and +1 Damage this activation. The bank is empty afterwards.",
  "risk_cost": "resource"
 },
 "faction_abilities": [
  {
   "scope": "all",
   "uptime": 0.1,
   "mods": {
    "hit_mod": 1
   },
   "name": "Pyre-Dice",
   "text": "One replaced die per activation (~1 in 10 dice)."
  },
  {
   "scope": "all",
   "uptime": 0.04,
   "mods": {
    "dmg_mod": 1
   },
   "name": "Martyr's Pyre",
   "text": "Once per battle on one unit."
  }
 ],
